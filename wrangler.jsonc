{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cryptotaxlocal",
  "compatibility_date": "2026-04-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // SPA: redirige toutes les routes vers index.html
    "not_found_handling": "single-page-application"
  }
}
